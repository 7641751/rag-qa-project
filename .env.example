# rag_qa_project/.env.example —— docker compose 用的环境变量模板
# 用法：cp .env.example .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会入库）
# 说明：compose 只把这些变量注入 backend 容器；MySQL / Redis 的容器内地址由 compose 固定为
#       服务名，这里只需要密钥与模型端点。改密码需先删数据卷（mysql_data / redis_data）再起。

# ---- LLM / 嵌入（必填）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=

# ---- 鉴权（必填，≥32 字节；生成：openssl rand -hex 32）----
RAGQA_JWT_SECRET=

# ---- 容器内 MySQL / Redis 的密码（可选，不填用默认值）----
MYSQL_ROOT_PASSWORD=ragqa_root_pw
MYSQL_PASSWORD=ragqa_pw
REDIS_PASSWORD=ragqa_redis_pw

# ---- LangSmith 追踪（可选）----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT_NAME=ragqa
LANGSMITH_ENDPOINT=
